<Window x:Class="Hushward.App.Warnings.WarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushward.App.Localization"
        Title="{x:Static loc:UiText.WarningTitle}"
        Width="430"
        Height="310"
        MinWidth="390"
        MinHeight="290"
        ResizeMode="CanMinimize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="ToolWindow"
        Background="{StaticResource DeepNightBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static loc:UiText.WarningTitle}"
                       Foreground="{StaticResource MistBrush}"
                       FontSize="20"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding ReasonText}"
                       Foreground="{StaticResource QuietGrayBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <TextBlock Text="{Binding RemainingText}"
                       Foreground="{StaticResource BeaconBrush}"
                       FontSize="42"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Margin="0,8,0,0"
                       Text="{x:Static loc:UiText.WarningCancelHint}"
                       Foreground="{StaticResource MistBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="LiveAnnouncement"
                       Width="1"
                       Height="1"
                       Opacity="0.01"
                       AutomationProperties.LiveSetting="Assertive" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Command="{Binding CancelCommand}"
                    Content="{x:Static loc:UiText.Cancel}" />
            <StackPanel Grid.Column="1"
                        Margin="10,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                <Button Margin="0,0,5,0"
                        Command="{Binding Postpone15Command}"
                        Content="{x:Static loc:UiText.WarningPostpone15}" />
                <Button Margin="0,0,5,0"
                        Command="{Binding Postpone30Command}"
                        Content="{x:Static loc:UiText.WarningPostpone30}" />
                <Button Command="{Binding Postpone60Command}"
                        Content="{x:Static loc:UiText.WarningPostpone60}" />
            </StackPanel>
            <Button Grid.Column="2"
                    Command="{Binding KeepActiveUntilTomorrowCommand}"
                    Content="{x:Static loc:UiText.WarningKeepActiveTomorrow}" />
        </Grid>
    </Grid>
</Window>
