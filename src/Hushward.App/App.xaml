<Application x:Class="Hushward.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Design/Colors.xaml" />
                <ResourceDictionary Source="Design/Typography.xaml" />
                <ResourceDictionary Source="Design/Controls.xaml" />
                <ResourceDictionary Source="Design/Motion.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <DrawingImage x:Key="AppIconImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="{StaticResource DeepNightBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="16,16"
                                             RadiusX="15"
                                             RadiusY="15" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource MistBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="14,14"
                                             RadiusX="6"
                                             RadiusY="9" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource DeepNightBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="17,13"
                                             RadiusX="6"
                                             RadiusY="10" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource SafeBrush}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="23,23"
                                             RadiusX="5"
                                             RadiusY="5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource MistBrush}"
                                 Thickness="2" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="23,23"
                                             RadiusX="5"
                                             RadiusY="5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        </ResourceDictionary>
    </Application.Resources>
</Application>
