<UserControl x:Class="Hushward.App.Views.Secondary.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:Hushward.App.Localization">
    <StackPanel>
        <TextBlock Text="{x:Static loc:UiText.HistoryTitle}"
                   FontSize="18"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,0"
                   Text="{x:Static loc:UiText.HistoryEmpty}" />
    </StackPanel>
</UserControl>
