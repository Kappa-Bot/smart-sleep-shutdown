<Window x:Class="Hushward.App.Views.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushward.App.Localization"
        Title="{x:Static loc:UiText.AppTitle}"
        Width="520"
        Height="590"
        MinWidth="480"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{x:Static loc:UiText.AppTitle}"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource DeepNightBrush}" />
            <TextBlock Margin="0,8,0,0"
                       Text="{Binding StepTitle}"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </StackPanel>
        <ScrollViewer Grid.Row="1"
                      Margin="0,18,0,18"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource SurfaceCardStyle}"
                        Visibility="{Binding IsPurposeStep, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static loc:UiText.OnboardingPurposeBody}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{x:Static loc:UiText.OnboardingNeverBody}"
                                   Foreground="{StaticResource QuietGrayBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <StackPanel Visibility="{Binding IsActionStep, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static loc:UiText.OnboardingActionLabel}"
                               FontWeight="SemiBold" />
                    <ComboBox Margin="0,6,0,0"
                              ItemsSource="{Binding ActionOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Action"
                              SelectedValue="{Binding Action}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsScheduleStep, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{x:Static loc:UiText.OnboardingEarliestLabel}"
                                       FontWeight="SemiBold" />
                            <TextBox Margin="0,6,0,0"
                                     Text="{Binding Earliest}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{x:Static loc:UiText.OnboardingLatestLabel}"
                                       FontWeight="SemiBold" />
                            <TextBox Margin="0,6,0,0"
                                     Text="{Binding Latest}" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Margin="0,16,0,6"
                               Text="{x:Static loc:UiText.OnboardingIdleLabel}"
                               FontWeight="SemiBold" />
                    <TextBox Text="{Binding IdleMinutes}" />
                </StackPanel>
                <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox IsChecked="{Binding StartWithWindows}"
                              Content="{x:Static loc:UiText.OnboardingStartupLabel}" />
                    <CheckBox Margin="0,10,0,0"
                              IsChecked="{Binding WakeEnabled}"
                              Content="{x:Static loc:UiText.OnboardingWakeLabel}" />
                    <Border Margin="0,16,0,0"
                            Style="{StaticResource SurfaceCardStyle}">
                        <TextBlock Text="{Binding Summary}"
                                   TextWrapping="Wrap"
                                   FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Command="{Binding NextCommand}"
                    Content="{x:Static loc:UiText.OnboardingNext}" />
            <Button Command="{Binding ConfirmCommand}"
                    Content="{x:Static loc:UiText.OnboardingConfirm}" />
        </StackPanel>
    </Grid>
</Window>
