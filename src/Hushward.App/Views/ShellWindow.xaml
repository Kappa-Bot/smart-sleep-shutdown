<Window x:Class="Hushward.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Hushward.App.Localization"
        xmlns:viewModels="clr-namespace:Hushward.App.ViewModels"
        Title="{x:Static loc:UiText.AppTitle}"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppIconImage}"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="0" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DeepNightBrush}"
                Padding="20,18,20,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="46"
                            Height="46"
                            Margin="0,0,12,0"
                            Background="{StaticResource NightSlateBrush}"
                            CornerRadius="8">
                        <Grid>
                            <Image Width="32"
                                   Height="32"
                                   Source="{StaticResource AppIconImage}" />
                            <Ellipse Width="10"
                                     Height="10"
                                     Margin="0,0,5,5"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Fill="{Binding HeaderStatusBrush}"
                                     Stroke="{StaticResource DeepNightBrush}"
                                     StrokeThickness="2" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center">
                        <TextBlock Text="{x:Static loc:UiText.AppTitle}"
                                   Foreground="{StaticResource MistBrush}"
                                   FontSize="22"
                                   FontWeight="SemiBold" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{x:Static loc:UiText.AppSubtitle}"
                                   Foreground="{StaticResource QuietGrayBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="2"
                            Margin="12,0,0,0"
                            Padding="9,6"
                            VerticalAlignment="Center"
                            Background="{StaticResource NightSlateBrush}"
                            BorderBrush="{StaticResource QuietGrayBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,6,0"
                                     VerticalAlignment="Center"
                                     Fill="{Binding HeaderStatusBrush}" />
                            <TextBlock x:Name="StatusBadgeText"
                                       MaxWidth="138"
                                       Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource MistBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl Grid.Row="1"
                            Margin="0,12,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            TabStripPlacement="Top">
                    <TabControl.Resources>
                        <Style TargetType="TabItem"
                               BasedOn="{StaticResource NavTabItemStyle}" />
                    </TabControl.Resources>
                    <TabItem Header="{x:Static loc:UiText.NavHome}">
                        <ScrollViewer Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <StackPanel Margin="0,0,0,16">
                                <Border Style="{StaticResource SurfaceCardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static loc:UiText.PrimaryStatusLabel}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                            <TextBlock Margin="0,5,12,0"
                                                       Text="{Binding StatusText}"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.Name="{x:Static loc:UiText.StatusLiveRegionName}"
                                                       AutomationProperties.LiveSetting="Polite" />
                                            <TextBlock Margin="0,7,12,0"
                                                       Text="{x:Static loc:UiText.NoSilentShutdownHint}"
                                                       Foreground="{StaticResource QuietGrayBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1"
                                                      Style="{StaticResource HushwardToggleStyle}"
                                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Content="{Binding IsEnabled, Converter={x:Static viewModels:BooleanBoxes.OnOffConverter}}"
                                                      AutomationProperties.Name="{x:Static loc:UiText.EnableAutomationName}" />
                                    </Grid>
                                </Border>
                                <Border Margin="0,12,0,0"
                                        Style="{StaticResource SurfaceCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static loc:UiText.RoutineHint}"
                                                   Style="{StaticResource CaptionTextStyle}" />
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding ScheduleSummaryText}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,12,0,0"
                                        Padding="12"
                                        Background="{StaticResource PanelBrush}"
                                        BorderBrush="{StaticResource CriticalBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding IsSettingsWarningVisible, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding SettingsWarningText}"
                                               Foreground="{StaticResource CriticalBrush}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{x:Static loc:UiText.NavTonight}">
                        <ScrollViewer Margin="0,16,0,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{x:Static loc:UiText.TonightHint}"
                                           Foreground="{StaticResource QuietGrayBrush}"
                                           TextWrapping="Wrap" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Style="{StaticResource SurfaceCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static loc:UiText.StartTimeLabel}"
                                                       FontWeight="SemiBold" />
                                            <TextBox Margin="0,7,0,0"
                                                     Text="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{x:Static loc:UiText.StartTimeLabel}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{x:Static loc:UiText.StartTimeHint}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2"
                                            Style="{StaticResource SurfaceCardStyle}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static loc:UiText.IdleLabel}"
                                                       FontWeight="SemiBold" />
                                            <TextBox Margin="0,7,0,0"
                                                     Text="{Binding IdleThresholdMinutes, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{x:Static loc:UiText.IdleLabel}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       Text="{x:Static loc:UiText.IdleHint}"
                                                       Style="{StaticResource CaptionTextStyle}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Button Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Command="{Binding DisableUntilTomorrowCommand}"
                                        Content="{x:Static loc:UiText.PauseToday}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{x:Static loc:UiText.NavRoutines}">
                        <Border Margin="0,16,0,16"
                                Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:UiText.RoutineHint}"
                                           Style="{StaticResource CaptionTextStyle}" />
                                <TextBlock Margin="0,6,0,0"
                                           Text="{Binding ScheduleSummaryText}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                    <TabItem Header="{x:Static loc:UiText.NavProtections}">
                        <Border Margin="0,16,0,16"
                                Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel>
                                <TextBlock Text="{x:Static loc:UiText.ProtectionsLabel}"
                                           FontSize="18"
                                           FontWeight="SemiBold" />
                                <TextBlock Margin="0,6,0,12"
                                           Text="{x:Static loc:UiText.ProtectionsHint}"
                                           Foreground="{StaticResource QuietGrayBrush}"
                                           TextWrapping="Wrap" />
                                <CheckBox IsChecked="{Binding ContextChecksEnabled, Mode=TwoWay}"
                                          Content="{x:Static loc:UiText.ContextChecksLabel}" />
                            </StackPanel>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="16,12,16,0"
                Padding="14"
                Background="{StaticResource DeepNightBrush}"
                BorderBrush="{StaticResource BeaconBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsCountdownActive, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:UiText.WarningPrefix}"
                               Foreground="{StaticResource MistBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CountdownSecondsRemaining, Mode=OneWay}"
                               Foreground="{StaticResource BeaconBrush}"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{x:Static loc:UiText.WarningSuffix}"
                               Foreground="{StaticResource MistBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelShutdownCommand}"
                        Content="{x:Static loc:UiText.Cancel}" />
            </Grid>
        </Border>

        <Grid x:Name="FooterLayout"
              Grid.Row="3"
              Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:UiText.FooterHint}"
                       Foreground="{StaticResource QuietGrayBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <Ellipse Grid.Column="1"
                     Width="9"
                     Height="9"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{Binding HeaderStatusBrush}" />
        </Grid>
    </Grid>
</Window>
