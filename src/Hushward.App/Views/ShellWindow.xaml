<Window x:Class="Hushward.App.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:home="clr-namespace:Hushward.App.Views.Home"
        xmlns:loc="clr-namespace:Hushward.App.Localization"
        xmlns:protections="clr-namespace:Hushward.App.Views.Protections"
        xmlns:routines="clr-namespace:Hushward.App.Views.Routines"
        xmlns:tonight="clr-namespace:Hushward.App.Views.Tonight"
        xmlns:viewModels="clr-namespace:Hushward.App.ViewModels"
        Title="{x:Static loc:UiText.AppTitle}"
        Width="560"
        Height="640"
        MinWidth="520"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource AppIconImage}"
        Background="{StaticResource SurfaceBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
                Padding="20,18"
                Background="{StaticResource DeepNightBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46"
                        Height="46"
                        Margin="0,0,12,0"
                        Background="{StaticResource NightSlateBrush}"
                        CornerRadius="8">
                    <Grid>
                        <Image Width="32"
                               Height="32"
                               Source="{StaticResource AppIconImage}" />
                        <Ellipse Width="10"
                                 Height="10"
                                 Margin="0,0,5,5"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Fill="{Binding HeaderStatusBrush}"
                                 Stroke="{StaticResource DeepNightBrush}"
                                 StrokeThickness="2" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:UiText.AppTitle}"
                               Foreground="{StaticResource MistBrush}"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,2,0,0"
                               Text="{x:Static loc:UiText.AppSubtitle}"
                               Foreground="{StaticResource QuietGrayBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="2"
                        Margin="12,0,0,0"
                        Padding="9,6"
                        VerticalAlignment="Center"
                        Background="{StaticResource NightSlateBrush}"
                        BorderBrush="{StaticResource QuietGrayBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding HeaderStatusBrush}" />
                        <TextBlock x:Name="StatusBadgeText"
                                   MaxWidth="138"
                                   Text="{Binding StatusText}"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MistBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <TabControl Grid.Row="1"
                    Margin="18,0,18,0"
                    Background="Transparent"
                    BorderThickness="0"
                    TabStripPlacement="Top">
            <TabControl.Resources>
                <Style TargetType="TabItem"
                       BasedOn="{StaticResource NavTabItemStyle}">
                    <Setter Property="Foreground"
                            Value="{StaticResource TextPrimaryBrush}" />
                </Style>
            </TabControl.Resources>
            <TabItem Header="{x:Static loc:UiText.NavHome}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <StackPanel Margin="0,18,0,16">
                        <Border Style="{StaticResource SurfaceCardStyle}">
                            <home:HomeView DataContext="{Binding Home}" />
                        </Border>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center"
                                       Text="{x:Static loc:UiText.NoSilentShutdownHint}"
                                       Foreground="{StaticResource QuietGrayBrush}"
                                       TextWrapping="Wrap" />
                            <ToggleButton Grid.Column="1"
                                          Margin="12,0,0,0"
                                          Style="{StaticResource HushwardToggleStyle}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          Content="{Binding IsEnabled, Converter={x:Static viewModels:BooleanBoxes.OnOffConverter}}"
                                          AutomationProperties.Name="{x:Static loc:UiText.EnableAutomationName}" />
                        </Grid>
                        <Border Margin="0,12,0,0"
                                Padding="12"
                                BorderBrush="{StaticResource CriticalBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="{Binding IsSettingsWarningVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SettingsWarningText}"
                                       Foreground="{StaticResource CriticalBrush}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static loc:UiText.NavTonight}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Border Margin="0,18,0,16"
                            Style="{StaticResource SurfaceCardStyle}">
                        <tonight:TonightView DataContext="{Binding Tonight}" />
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static loc:UiText.NavRoutines}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Border Margin="0,18,0,16"
                            Style="{StaticResource SurfaceCardStyle}">
                        <routines:RoutinesView DataContext="{Binding Routines}" />
                    </Border>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{x:Static loc:UiText.NavProtections}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False">
                    <Border Margin="0,18,0,16"
                            Style="{StaticResource SurfaceCardStyle}">
                        <protections:ProtectionsView DataContext="{Binding Protections}" />
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2"
                Margin="18,0,18,0"
                Padding="14"
                Background="{StaticResource DeepNightBrush}"
                BorderBrush="{StaticResource BeaconBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsCountdownActive, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{x:Static loc:UiText.WarningPrefix}"
                               Foreground="{StaticResource MistBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CountdownSecondsRemaining, Mode=OneWay}"
                               Foreground="{StaticResource BeaconBrush}"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="{x:Static loc:UiText.WarningSuffix}"
                               Foreground="{StaticResource MistBrush}"
                               FontWeight="SemiBold" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding CancelShutdownCommand}"
                        Content="{x:Static loc:UiText.Cancel}" />
            </Grid>
        </Border>
        <Grid x:Name="FooterLayout"
              Grid.Row="3"
              Margin="20,12,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{x:Static loc:UiText.FooterHint}"
                       Foreground="{StaticResource QuietGrayBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />
            <Ellipse Grid.Column="1"
                     Width="9"
                     Height="9"
                     Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Fill="{Binding HeaderStatusBrush}" />
        </Grid>
    </Grid>
</Window>
