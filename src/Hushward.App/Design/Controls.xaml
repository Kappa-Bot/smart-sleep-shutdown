<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <CornerRadius x:Key="ControlRadius">8</CornerRadius>
    <Thickness x:Key="FocusThickness">2</Thickness>
    <Style x:Key="SurfaceCardStyle"
           TargetType="Border">
        <Setter Property="Background"
                Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="CornerRadius"
                Value="{StaticResource ControlRadius}" />
        <Setter Property="Padding"
                Value="16" />
    </Style>
    <Style x:Key="HushCardStyle"
           TargetType="Border"
           BasedOn="{StaticResource SurfaceCardStyle}" />
    <Style TargetType="TextBox">
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="Padding"
                Value="10,6" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="BorderBrush"
                Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Background"
                Value="{StaticResource PanelBrush}" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinHeight"
                Value="36" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
    </Style>
    <Style x:Key="NavTabItemStyle"
           TargetType="TabItem">
        <Setter Property="Foreground"
                Value="{StaticResource QuietGrayBrush}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Padding"
                Value="12,10" />
        <Setter Property="MinHeight"
                Value="44" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="NavSurface"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="NavSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource BeaconBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin"
                                 Value="True">
                            <Setter TargetName="NavSurface"
                                    Property="Background"
                                    Value="{StaticResource NightSlateBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="HushwardToggleStyle"
           TargetType="ToggleButton">
        <Setter Property="MinWidth"
                Value="132" />
        <Setter Property="Height"
                Value="42" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="Foreground"
                Value="{StaticResource MistBrush}" />
        <Setter Property="Background"
                Value="{StaticResource QuietGrayBrush}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource QuietGrayBrush}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleSurface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource ControlRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked"
                                 Value="True">
                            <Setter TargetName="ToggleSurface"
                                    Property="Background"
                                    Value="{StaticResource SafeBrush}" />
                            <Setter TargetName="ToggleSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource SafeBrush}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource DeepNightBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="ToggleSurface"
                                    Property="BorderBrush"
                                    Value="{StaticResource BeaconBrush}" />
                            <Setter TargetName="ToggleSurface"
                                    Property="BorderThickness"
                                    Value="{StaticResource FocusThickness}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
