<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="DeepNightColor">#0B1020</Color>
    <Color x:Key="NightSlateColor">#141B2D</Color>
    <Color x:Key="MistColor">#E8ECF3</Color>
    <Color x:Key="QuietGrayColor">#98A3B8</Color>
    <Color x:Key="BeaconColor">#F2B84B</Color>
    <Color x:Key="SafeColor">#66C7A5</Color>
    <Color x:Key="WarningColor">#F29E4C</Color>
    <Color x:Key="CriticalColor">#E56B6F</Color>
    <SolidColorBrush x:Key="DeepNightBrush"
                     Color="{StaticResource DeepNightColor}" />
    <SolidColorBrush x:Key="NightSlateBrush"
                     Color="{StaticResource NightSlateColor}" />
    <SolidColorBrush x:Key="MistBrush"
                     Color="{StaticResource MistColor}" />
    <SolidColorBrush x:Key="QuietGrayBrush"
                     Color="{StaticResource QuietGrayColor}" />
    <SolidColorBrush x:Key="BeaconBrush"
                     Color="{StaticResource BeaconColor}" />
    <SolidColorBrush x:Key="SafeBrush"
                     Color="{StaticResource SafeColor}" />
    <SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="CriticalBrush"
                     Color="{StaticResource CriticalColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="#F5F7FB" />
    <SolidColorBrush x:Key="PanelBrush"
                     Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderSubtleBrush"
                     Color="#DCE3EE" />
    <SolidColorBrush x:Key="TextPrimaryBrush"
                     Color="#111827" />
</ResourceDictionary>
